# LLM API Keys
OPENAI_API_KEY=your-api-key
ANTHROPIC_API_KEY=your-api-key
GOOGLE_API_KEY=your-api-key
XAI_API_KEY=your-api-key

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# === Korean Market APIs ===

# Korea Investment & Securities (한국투자증권)
# Get credentials at: https://apiportal.koreainvestment.com
KIS_APP_KEY=your-app-key
KIS_APP_SECRET=your-app-secret
KIS_ACCOUNT_NO=12345678
KIS_ACCOUNT_PROD=01
KIS_ENV=prod

# DART Open API (금융감독원 전자공시)
# Get API key at: https://opendart.fss.or.kr
DART_API_KEY=your-api-key

# Naver Search API (네이버 검색)
# Get credentials at: https://developers.naver.com
NAVER_CLIENT_ID=your-client-id
NAVER_CLIENT_SECRET=your-client-secret

# Web Search API Keys (Exa preferred, Tavily fallback)
EXASEARCH_API_KEY=your-api-key
TAVILY_API_KEY=your-api-key

# LangSmith 
LANGSMITH_API_KEY=your-api-key
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=dexter
LANGSMITH_TRACING=true
